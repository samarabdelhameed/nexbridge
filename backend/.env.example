# --- Server ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# --- Database (SQLite for local dev; Postgres in docker-compose) ---
DATABASE_URL=file:./dev.db

# --- Relayer wallet (funded on BOTH chains) ---
RELAYER_PRIVATE_KEY=0x...

# --- L1: Sepolia ---
L1_CHAIN_ID=11155111
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
L1_WS_URL=
L1_VAULT_ADDRESS=0x0bdccc047f288456dd7933026e5ff5a4bb49f4d1
L1_EXPLORER_URL=https://sepolia.etherscan.io
L1_CONFIRMATIONS=2

# --- L2: Abstract Testnet ---
L2_CHAIN_ID=11124
L2_RPC_URL=https://api.testnet.abs.xyz
L2_WS_URL=
L2_VAULT_ADDRESS=0x0bdccc047f288456dd7933026e5ff5a4bb49f4d1
L2_EXPLORER_URL=https://explorer.testnet.abs.xyz
L2_CONFIRMATIONS=2

# --- Relayer tuning ---
RELEASE_MAX_RETRIES=3
RELEASE_RETRY_BASE_MS=2000
RELEASE_RETRY_BACKOFF=2
CONFIRMATION_POLL_MS=2000
CONFIRMATION_TIMEOUT_MS=900000
POLL_INTERVAL_MS=2000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Prisma logging (true/false) ---
PRISMA_LOG=false
