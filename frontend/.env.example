# --- Vault addresses (real testnet deployments — defaults are hardcoded in code) ---
NEXT_PUBLIC_L1_VAULT_ADDRESS=0x0bdccc047f288456dd7933026e5ff5a4bb49f4d1
NEXT_PUBLIC_L2_VAULT_ADDRESS=0x0bdccc047f288456dd7933026e5ff5a4bb49f4d1

# --- Chain RPC URLs (real testnets; code falls back to these when unset) ---
NEXT_PUBLIC_L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_L2_RPC_URL=https://api.testnet.abs.xyz

# --- Backend API ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# --- WalletConnect (create a project at cloud.walletconnect.com) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=21fef48091f12692cad574a6f7753643

# --- Explorer overrides (optional) ---
NEXT_PUBLIC_L1_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_L2_EXPLORER_URL=https://explorer.testnet.abs.xyz
