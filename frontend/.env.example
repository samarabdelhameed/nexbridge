# --- Vault addresses (deployed via contracts/) ---
NEXT_PUBLIC_L1_VAULT_ADDRESS=0x...
NEXT_PUBLIC_L2_VAULT_ADDRESS=0x...

# --- Chain RPC URLs (fall back to public testnet RPCs when unset) ---
NEXT_PUBLIC_L1_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_L2_RPC_URL=http://127.0.0.1:8546

# --- Backend API ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# --- WalletConnect (create a project at cloud.walletconnect.com) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Explorer overrides (optional) ---
NEXT_PUBLIC_L1_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_L2_EXPLORER_URL=https://explorer.testnet.abs.xyz
