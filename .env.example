# ==============================================================================
# NexBridge — single source of truth for the whole project
# ==============================================================================
# Copy to .env and edit. The backend loads this file automatically
# (backend/src/config/env.ts), docker-compose reads it, and scripts/local.sh
# uses it to deploy vaults + start the stack.
#
# Two setups:
#   A) Local demo (no external services) — leave the URLs below pointing at
#      `anvil` chains; run `npm run dev` and connect MetaMask to the anvil RPC.
#   B) Real testnets — set public RPC/WS URLs, deploy the vaults with the
#      deploy scripts (contracts/), then fill the vault addresses here.
# ==============================================================================

# ------------------------------------------------------------------------------
# Chains
# ------------------------------------------------------------------------------
L1_CHAIN_ID=11155111
L1_RPC_URL=http://127.0.0.1:8545
L1_WS_URL=
L1_VAULT_ADDRESS=0x...
L1_EXPLORER_URL=https://sepolia.etherscan.io
L1_CONFIRMATIONS=2

L2_CHAIN_ID=11124
L2_RPC_URL=http://127.0.0.1:8546
L2_WS_URL=
L2_VAULT_ADDRESS=0x...
L2_EXPLORER_URL=https://explorer.testnet.abs.xyz
L2_CONFIRMATIONS=2

# ------------------------------------------------------------------------------
# Wallets
# ------------------------------------------------------------------------------
# Anvil deterministic accounts (funded with 10k ETH on both chains).
# Deployer (anvil #0) 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Relayer (anvil #1) 0x70997970C51812dc3A010C7d01b50e0d17dc79C8
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
RELAYER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# User / tester (anvil #5) 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
USER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
USER_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# Liquidity seeded into the L2 vault at deploy time (wei)
L2_LIQUIDITY_WEI=10000000000000000000

# ------------------------------------------------------------------------------
# Backend (server / db / relayer tuning / rate limiting)
# ------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# SQLite for local dev; swap to Postgres in docker-compose:
# DATABASE_URL=postgresql://nexbridge:nexbridge@localhost:5432/nexbridge
DATABASE_URL=file:./dev.db

RELEASE_MAX_RETRIES=3
RELEASE_RETRY_BASE_MS=2000
RELEASE_RETRY_BACKOFF=2
CONFIRMATION_POLL_MS=1000
CONFIRMATION_TIMEOUT_MS=300000
POLL_INTERVAL_MS=1000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

PRISMA_LOG=false

# ------------------------------------------------------------------------------
# Frontend (Next.js bakes NEXT_PUBLIC_* at build time — also mirrored into
# frontend/.env.local by scripts/local.sh)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_L1_VAULT_ADDRESS=0x...
NEXT_PUBLIC_L2_VAULT_ADDRESS=0x...
NEXT_PUBLIC_L1_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_L2_RPC_URL=http://127.0.0.1:8546
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Get a free project id at cloud.walletconnect.com for WalletConnect to work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_L1_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_L2_EXPLORER_URL=https://explorer.testnet.abs.xyz
